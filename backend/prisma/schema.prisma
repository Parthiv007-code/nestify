generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String
  state     String?
  district  String?
  city      String?
  pincode   String?
  createdAt DateTime @default(now())

  listings       Listing[] @relation("ListingOwner")
  rentedListings Listing[] @relation("ListingRenter")
}

model Listing {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  rent        Int
  state       String
  district    String
  city        String
  pincode     String
  bedrooms    Int
  bathrooms   Int
  imageUrl    String?  // legacy single-image field, kept so old seeded listings still show a photo
  status      String   @default("AVAILABLE")
  type        String   @default("RENT") // "RENT" or "PG"
  createdAt   DateTime @default(now())

  owner       User     @relation("ListingOwner", fields: [ownerId], references: [id])
  ownerId     Int

  renter      User?    @relation("ListingRenter", fields: [renterId], references: [id])
  renterId    Int?

  images      ListingImage[]
}

model ListingImage {
  id        Int      @id @default(autoincrement())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
}